# ==============================================================================
# TaniCo Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & DEPLOYMENT ROUTING (CRITICAL FOR VERCEL)
# ------------------------------------------------------------------------------
# [SERVER ONLY] URL of the Express backend in production.
# Example: https://tanico-backend.vercel.app (WITHOUT trailing slash and WITHOUT /api)
# In Next.js SSR and rewrites, this routes all /api/* requests to the Express server.
INTERNAL_API_URL=

# [SERVER ONLY] Allowed frontend origins for CORS in Express.js (comma-separated if multiple).
# Example: https://tanico.vercel.app
FRONTEND_URL=

# [SERVER ONLY] Runtime environment ('development' or 'production').
NODE_ENV=production

# [SERVER ONLY] Express backend port for local/container development (default: 5000).
BACKEND_PORT=5000

# ------------------------------------------------------------------------------
# 2. PRISMA & POSTGRESQL DATABASE (SUPABASE)
# ------------------------------------------------------------------------------
# [SERVER ONLY] Transaction Connection Pooler URL (Supabase port 6543 with ?pgbouncer=true).
# CRITICAL FOR VERCEL SERVERLESS to prevent connection exhaustion (code P1001 / 53300).
# Example: postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# [SERVER ONLY] Direct Connection URL (Supabase port 5432) used exclusively for Prisma migrations.
# Example: postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=

# ------------------------------------------------------------------------------
# 3. SUPABASE STORAGE & BACKEND SERVICES
# ------------------------------------------------------------------------------
# [SERVER ONLY] Supabase project URL and service role secret key.
# Used exclusively by the Express backend (server/services/supabase.js) for storage & uploads.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser / NEXT_PUBLIC_ variables!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# [PUBLIC] Optional client-side Supabase URL (if needed by browser for public CDN images).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# [SERVER ONLY] Secret key (minimum 32 characters) for signing and verifying user session tokens.
SESSION_SECRET="tanico_secure_default_session_secret_key_32chars_min"

# ------------------------------------------------------------------------------
# 5. OPTIONAL PLATFORM KEYS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
APP_URL=

